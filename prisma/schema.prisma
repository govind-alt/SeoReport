// RankFlow — Prisma Schema v2 (Enhanced)
// SQLite for dev, Postgres for production

generator client {
  provider    = "prisma-client-js"
  engineType  = "library"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────────────────────
// AGENCY & USERS
// ─────────────────────────────────────────────────────────────────────────────

model Agency {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  subdomain       String?  @unique
  plan            String   @default("starter") // starter, pro, agency
  billingEmail    String?
  notificationEmail String? // Dedicated email for client message/query alerts
  customDomain    String?
  serankingApiKey String?  // AES-256 encrypted
  googleRefreshToken String? // OAuth 2.0 refresh token for GSC
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripePriceId String?
  brandingJson    String?  // { primaryColor, logoUrl, accentColor }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  clients         Client[]
  reportSchedules ReportSchedule[]
  invitations     Invitation[]
  notifications   Notification[]
  messages        Message[]
  webhooks        WebhookEndpoint[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  role          String    @default("member") // superadmin | admin | member | client
  agencyId      String?
  stripeCustomerId String?
  agency        Agency?   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  accounts      Account[]
  sessions      Session[]
  invitations   Invitation[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id                 String   @id @default(cuid())
  name               String
  domain             String
  industry           String?
  notes              String?
  contactEmail       String?
  contactName        String?
  logo               String?
  serankingProjectId Int?     // SERanking numeric project ID
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  serankingProject   SERankingProject?
  reports            Report[]
  reportSchedule     ReportSchedule?
  invitations        Invitation[]
  messages           Message[]
}

// ─────────────────────────────────────────────────────────────────────────────
// SERANKING PROJECT (linked to Client)
// ─────────────────────────────────────────────────────────────────────────────

model SERankingProject {
  id           String   @id @default(cuid())
  serankingId  Int      @unique  // Numeric project ID from SERanking API
  name         String
  url          String
  clientId     String   @unique
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  keywordSnapshots   KeywordSnapshot[]
  backlinkSnapshots  BacklinkSnapshot[]
  auditSnapshots     AuditSnapshot[]
  analyticsSnapshots AnalyticsSnapshot[]
}

// ─────────────────────────────────────────────────────────────────────────────
// SNAPSHOTS — Daily sync data from SERanking
// ─────────────────────────────────────────────────────────────────────────────

model KeywordSnapshot {
  id                 String           @id @default(cuid())
  date               DateTime
  serankingProjectId String
  project            SERankingProject @relation(fields: [serankingProjectId], references: [id], onDelete: Cascade)
  top3Count          Int              @default(0)
  top10Count         Int              @default(0)
  top30Count         Int              @default(0)
  top100Count        Int              @default(0)
  totalKeywords      Int              @default(0)
  avgPosition        Float?
  positionsJson      String?          // JSON array of keyword positions
  createdAt          DateTime         @default(now())

  @@unique([serankingProjectId, date])
  @@index([serankingProjectId, date])
}

model BacklinkSnapshot {
  id                 String           @id @default(cuid())
  date               DateTime
  serankingProjectId String
  project            SERankingProject @relation(fields: [serankingProjectId], references: [id], onDelete: Cascade)
  domainTrust        Int?
  totalBacklinks     Int              @default(0)
  newBacklinks       Int              @default(0)
  lostBacklinks      Int              @default(0)
  referringDomains   Int              @default(0)
  dofollowLinks      Int              @default(0)
  nofollowLinks      Int              @default(0)
  createdAt          DateTime         @default(now())

  @@unique([serankingProjectId, date])
  @@index([serankingProjectId, date])
}

model AuditSnapshot {
  id                 String           @id @default(cuid())
  date               DateTime
  serankingProjectId String
  project            SERankingProject @relation(fields: [serankingProjectId], references: [id], onDelete: Cascade)
  healthScore        Int              @default(0)
  pagesCrawled       Int              @default(0)
  criticalIssues     Int              @default(0)
  warningIssues      Int              @default(0)
  noticeIssues       Int              @default(0)
  issuesJson         String?          // Full issues JSON
  createdAt          DateTime         @default(now())

  @@unique([serankingProjectId, date])
  @@index([serankingProjectId, date])
}

model AnalyticsSnapshot {
  id                 String           @id @default(cuid())
  date               DateTime
  serankingProjectId String
  project            SERankingProject @relation(fields: [serankingProjectId], references: [id], onDelete: Cascade)
  organicSessions    Int              @default(0)
  clicks             Int              @default(0)
  impressions        Int              @default(0)
  ctr                Float?
  avgPosition        Float?
  topQueriesJson     String?          // JSON: [{ query, clicks, impressions, ctr, position }]
  topPagesJson       String?          // JSON: [{ page, clicks, impressions }]
  createdAt          DateTime         @default(now())

  @@unique([serankingProjectId, date])
  @@index([serankingProjectId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  status       String    @default("draft") // draft | generating | done | failed
  sectionsJson String?   // { keywords, backlinks, audit, analytics, competitors, aiRecs }
  pdfUrl       String?
  aiRecsJson   String?   // AI-generated recommendations JSON
  shareSlug    String?   @unique
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, periodStart])
}

model ReportSchedule {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId   String   @unique
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayOfMonth Int      @default(1)
  autoSend   Boolean  @default(false)
  isActive   Boolean  @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// INVITATIONS (Client Portal access)
// ─────────────────────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// WEBHOOKS
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEndpoint {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  url       String
  events    String   // JSON array of events like ["report.generated", "sync.failed"]
  secret    String?  // HMAC signature secret
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([agencyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type      String   // report | ranking | alert | sync | invite
  title     String
  body      String
  link      String?  // optional deep-link URL
  read      Boolean  @default(false)
  dismissed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// MESSAGES (Client Inbox)
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id           String   @id @default(cuid())
  subject      String?
  body         String
  isRead       Boolean  @default(false)
  isFromAgency Boolean  @default(false)
  senderName   String?
  
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime @default(now())

  @@index([agencyId, createdAt])
  @@index([clientId, createdAt])
}
