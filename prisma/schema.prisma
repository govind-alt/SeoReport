// RankFlow — Minimal Clean Schema (PostgreSQL)
// Core SaaS Models + SEO Snapshots

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. AGENCY (Tenant)
// ─────────────────────────────────────────────────────────────────────────────

model Agency {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  subdomain          String?  @unique
  plan               String   @default("starter") // starter, pro, agency
  status             String   @default("active") // active, trial, suspended
  billingEmail       String?
  notificationEmail  String?
  customDomain       String?
  serankingApiKey    String?  // AES-256 encrypted
  googleRefreshToken String?  // OAuth 2.0 refresh token for GSC
  stripeCustomerId   String?
  stripeSubscriptionId String?
  stripePriceId      String?
  brandingJson       String?  // { primaryColor, logoUrl, accentColor }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users              User[]
  clients            Client[]
  reportSchedules    ReportSchedule[]
  invitations        Invitation[]
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. USER (Auth & Team)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?
  role             String    @default("member") // superadmin | admin | member | client
  agencyId         String?
  stripeCustomerId String?
  agency           Agency?   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  invitations      Invitation[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. CLIENT
// ─────────────────────────────────────────────────────────────────────────────

model Client {
  id                 String   @id @default(cuid())
  name               String
  domain             String
  industry           String?
  notes              String?
  contactEmail       String?
  contactName        String?
  logo               String?
  serankingProjectId Int?     // SERanking numeric project ID
  agencyId           String
  agency             Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reports            Report[]
  reportSchedule     ReportSchedule?
  invitations        Invitation[]
  keywordSnapshots   KeywordSnapshot[]
  backlinkSnapshots  BacklinkSnapshot[]
  auditSnapshots     AuditSnapshot[]
  analyticsSnapshots AnalyticsSnapshot[]
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. SEO SNAPSHOTS (Directly attached to Client)
// ─────────────────────────────────────────────────────────────────────────────

model KeywordSnapshot {
  id            String   @id @default(cuid())
  date          DateTime
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  top3Count     Int      @default(0)
  top10Count    Int      @default(0)
  top30Count    Int      @default(0)
  top100Count   Int      @default(0)
  totalKeywords Int      @default(0)
  avgPosition   Float?
  positionsJson String?
  createdAt     DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model BacklinkSnapshot {
  id               String   @id @default(cuid())
  date             DateTime
  clientId         String
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domainTrust      Int?
  totalBacklinks   Int      @default(0)
  newBacklinks     Int      @default(0)
  lostBacklinks    Int      @default(0)
  referringDomains Int      @default(0)
  dofollowLinks    Int      @default(0)
  nofollowLinks    Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model AuditSnapshot {
  id             String   @id @default(cuid())
  date           DateTime
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  healthScore    Int      @default(0)
  pagesCrawled   Int      @default(0)
  criticalIssues Int      @default(0)
  warningIssues  Int      @default(0)
  noticeIssues   Int      @default(0)
  issuesJson     String?
  createdAt      DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

model AnalyticsSnapshot {
  id              String   @id @default(cuid())
  date            DateTime
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organicSessions Int      @default(0)
  clicks          Int      @default(0)
  impressions     Int      @default(0)
  ctr             Float?
  avgPosition     Float?
  topQueriesJson  String?
  topPagesJson    String?
  createdAt       DateTime @default(now())

  @@unique([clientId, date])
  @@index([clientId, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. REPORTS & SCHEDULES
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  periodStart  DateTime
  periodEnd    DateTime
  status       String    @default("draft") // draft | generating | done | failed
  sectionsJson String?
  pdfUrl       String?
  aiRecsJson   String?
  shareSlug    String?   @unique
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  generatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([clientId, periodStart])
}

model ReportSchedule {
  id         String    @id @default(cuid())
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId   String    @unique
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dayOfMonth Int       @default(1)
  autoSend   Boolean   @default(false)
  isActive   Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. INVITATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Invitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  agencyId    String
  agency      Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id])
  acceptedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([email])
}
